# ============================================================
# Template de variáveis de ambiente — copiar para .env
# NUNCA commitar o arquivo .env (já está no .gitignore)
# ============================================================
#
# Como obter os valores:
#   Supabase > Project Settings > API
#   Supabase > Project Settings > Database > Connection string

# ── Supabase — URL e chaves ───────────────────────────────────────────────

# URL pública do projeto Supabase (sem barra no final)
# Usado por: _upload_supabase.py, Docker, Prefect
SUPABASE_URL=https://[project-ref].supabase.co

# Chave anônima — acesso público somente leitura (segura para expor)
# Usada por: _upload_supabase.py (leitura), Prefect
SUPABASE_ANON_KEY=eyJ...

# Chave de serviço — acesso total de leitura/escrita
# Usada por: _upload_supabase.py (escrita), NUNCA pelo frontend
SUPABASE_SERVICE_KEY=eyJ...

# ── Frontend Vite — variáveis com prefixo VITE_ ───────────────────────────
# O Vite só expõe variáveis com prefixo VITE_ ao browser.
# Devem ter os mesmos valores que SUPABASE_URL e SUPABASE_ANON_KEY acima.

VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Conexão direta PostgreSQL (para ferramentas que precisam de SQL direto) ─
# Encontrar em: Supabase > Project Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[sua-senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ── Fontes externas ───────────────────────────────────────────────────────

# Token MapBiomas Alerta GraphQL API
# Obter em: https://plataforma.alerta.mapbiomas.org (criar conta gratuita)
MAPBIOMAS_TOKEN=

# ── Notificações (opcional) ───────────────────────────────────────────────

# Email para alertas de falha do Prefect
NOTIFICACAO_EMAIL=cgeo@semarh.pi.gov.br
